rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function profile() {
      return signedIn() ? userDoc(request.auth.uid).data : {};
    }

    function isActive() {
      return signedIn() && (!('status' in profile()) || profile().status != 'Suspended');
    }

    function isResident() {
      return signedIn() && profile().role == 'resident';
    }

    function isBarangayAdmin() {
      return signedIn() && profile().role == 'barangay_admin';
    }

    function sameBarangay(data) {
      return signedIn() && (
        data.barangay == profile().barangay ||
        data.targetBarangay == profile().barangay ||
        data.incidentBarangay == profile().barangay ||
        data.itemBarangay == profile().barangay ||
        data.homeBarangay == profile().barangay ||
        (data.keys().hasAny(['targetBarangays']) && data.targetBarangays.hasAny([profile().barangay]))
      );
    }

    function directlyTargetsCurrentUser(data) {
      return signedIn() && data.keys().hasAny(['targetUserIds']) && (
        data.targetUserIds.hasAny([request.auth.uid]) ||
        (request.auth.token.email != null && data.targetUserIds.hasAny([request.auth.token.email]))
      );
    }

    function visibleAnnouncement(data) {
      return signedIn() && (
        data.targetMode == 'all' ||
        sameBarangay(data)
      );
    }

    function isLostFound(data) {
      return data.type in ['lost', 'found'];
    }

    function createsOwnLostFoundRoute() {
      return signedIn() &&
        request.resource.data.type in ['lost', 'found'] &&
        request.resource.data.authorId == request.auth.uid &&
        (
          request.resource.data.homeBarangay == profile().barangay ||
          request.resource.data.barangay == profile().barangay ||
          (request.resource.data.keys().hasAny(['author']) && request.resource.data.author.barangay == profile().barangay)
        );
    }

    function owns(data) {
      return signedIn() && (
        data.userId == request.auth.uid ||
        data.authorId == request.auth.uid ||
        data.uid == request.auth.uid ||
        data.id == request.auth.uid
      );
    }

    function createsOwnBarangayRecord() {
      return signedIn() && (
        request.resource.data.barangay == profile().barangay ||
        request.resource.data.targetBarangay == profile().barangay
      );
    }

    match /users/{userId} {
      allow read: if signedIn() && (
        request.auth.uid == userId ||
        (isBarangayAdmin() && resource.data.barangay == profile().barangay)
      );

      allow create: if signedIn() && request.auth.uid == userId;

      allow update: if signedIn() && (
        (request.auth.uid == userId &&
          request.resource.data.diff(resource.data).changedKeys().hasOnly([
            'name', 'firstName', 'lastName', 'email', 'phone', 'barangay', 'avatar',
            'avatarUrl', 'avatarPublicId', 'profilePicture', 'bio',
            'emergencyContacts', 'notificationPreferences', 'securityPreferences', 'updatedAt'
          ])
        ) ||
        (isBarangayAdmin() && resource.data.barangay == profile().barangay)
      );

      allow delete: if false;
    }

    match /posts/{postId} {
      allow read: if signedIn() && (sameBarangay(resource.data) || owns(resource.data));
      allow create: if isResident() && isActive() && request.resource.data.authorId == request.auth.uid && (createsOwnBarangayRecord() || createsOwnLostFoundRoute());
      allow update: if signedIn() && (
        (isResident() && isActive() && owns(resource.data)) ||
        (isBarangayAdmin() && sameBarangay(resource.data))
      );
      allow delete: if signedIn() && (
        (isResident() && owns(resource.data)) ||
        (isBarangayAdmin() && sameBarangay(resource.data))
      );
    }

    match /postResponses/{responseId} {
      allow read: if signedIn();
      allow create: if isResident() && isActive() && request.resource.data.responderId == request.auth.uid;
      allow update, delete: if false;
    }

    match /emergencies/{emergencyId} {
      // Public emergency records are sanitized. Exact coordinates are stored separately
      // in /emergencyLocations so residents can see alerts without seeing the exact pin.
      allow read: if signedIn() && (
        (isBarangayAdmin() && sameBarangay(resource.data)) ||
        owns(resource.data) ||
        resource.data.visibility.showToPublic == true
      );
      allow create: if isResident() && isActive() && createsOwnBarangayRecord() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() && (
        (isResident() && isActive() && owns(resource.data)) ||
        (isBarangayAdmin() && sameBarangay(resource.data))
      );
      allow delete: if false;
    }

    match /emergencyLocations/{emergencyId} {
      allow read: if isBarangayAdmin() && sameBarangay(resource.data);
      allow create: if isResident() && isActive() && createsOwnBarangayRecord() && request.resource.data.authorId == request.auth.uid;
      allow update: if isBarangayAdmin() && sameBarangay(resource.data);
      allow delete: if false;
    }

    match /appointments/{appointmentId} {
      allow read: if signedIn() && (owns(resource.data) || (isBarangayAdmin() && sameBarangay(resource.data)));
      allow create: if isResident() && isActive() && createsOwnBarangayRecord() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() && (
        (isResident() && isActive() && owns(resource.data)) ||
        (isBarangayAdmin() && sameBarangay(resource.data))
      );
      allow delete: if false;
    }

    match /chats/{chatId} {
      allow read: if signedIn() && (
        request.auth.uid in resource.data.participants ||
        request.auth.token.email in resource.data.participantKeys ||
        (isBarangayAdmin() && resource.data.barangay == profile().barangay && resource.data.reported == true)
      );
      allow create: if signedIn() && isActive();
      allow update: if signedIn() && isActive() && (
        request.auth.uid in resource.data.participants ||
        request.auth.token.email in resource.data.participantKeys
      );
      allow delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && (sameBarangay(resource.data) || directlyTargetsCurrentUser(resource.data));
      allow create: if signedIn() && (
        createsOwnBarangayRecord() ||
        request.resource.data.homeBarangay == profile().barangay ||
        directlyTargetsCurrentUser(request.resource.data)
      );
      allow update: if signedIn() && (sameBarangay(resource.data) || directlyTargetsCurrentUser(resource.data));
      allow delete: if false;
    }

    match /announcements/{announcementId} {
      allow read: if signedIn() && visibleAnnouncement(resource.data);
      allow create, update, delete: if isBarangayAdmin() && createsOwnBarangayRecord();
    }

    match /reports/{reportId} {
      allow read: if signedIn() && (
        owns(resource.data) ||
        (isBarangayAdmin() && sameBarangay(resource.data))
      );
      allow create: if isResident() && isActive() && createsOwnBarangayRecord() && request.resource.data.reportedById == request.auth.uid;
      allow update: if isBarangayAdmin() && sameBarangay(resource.data);
      allow delete: if false;
    }

    match /auditLogs/{logId} {
      allow read: if isBarangayAdmin() && sameBarangay(resource.data);
      allow create: if isBarangayAdmin() && createsOwnBarangayRecord();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
